{
    "name": "fleetbase/fleetbase",
    "type": "project",
    "description": "Modular logistics and supply chain operating system (LSOS)",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Fleetbase Pte Ltd.",
            "email": "hello@fleetbase.io"
        },
        {
            "name": "Ronald A. Richardson",
            "email": "ron@fleetbase.io"
        }
    ],
    "require": {
        "php": ">=8.0 <8.3",
        "appstract/laravel-opcache": "^4.0",
        "fleetbase/core-api": "dev-security/rc1-fail-closed-tenant-lookup-20261110#e2076d396af95dbe77823f670cd50d4f12671e0c as 1.6.74",
        "fleetbase/ai": "^0.0.5",
        "fleetbase/fleetops-api": "dev-compat/p0-f8d3-r11-unsigned-decimal#665e4fdf16f0344a24a273ebd1599b92ba6c2728 as 0.6.75",
        "fleetbase/registry-bridge": "^0.1.11",
        "fleetbase/customer-portal-api": "^0.0.16",
        "fleetbase/storefront-api": "dev-compat/p0-f8d3-r12-uuid-default#b6d596154370ed5770225d889363a74fab56e584 as 0.4.31",
        "fleetbase/ledger-api": "^0.0.13",
        "fleetbase/valhalla-api": "^0.0.5",
        "fleetbase/vroom-api": "^0.0.5",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^12.69.2",
        "laravel/octane": "~2.22.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "maennchen/zipstream-php": "3.1.2",
        "phpoffice/phpspreadsheet": "^1.28",
        "predis/predis": "^2.1",
        "psr/http-factory-implementation": "*",
        "resend/resend-php": "^0.14.0",
        "s-ichikawa/laravel-sendgrid-driver": "^4.0",
        "stripe/stripe-php": "^17.0",
        "symfony/mailgun-mailer": "^7.1",
        "symfony/postmark-mailer": "^7.1"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/gsentsas/core-api",
            "canonical": true,
            "only": [
                "fleetbase/core-api"
            ]
        },
        {
            "type": "vcs",
            "url": "https://github.com/gsentsas/storefront",
            "canonical": true,
            "only": [
                "fleetbase/storefront-api"
            ]
        },
        {
            "type": "vcs",
            "url": "https://github.com/gsentsas/fleetops",
            "canonical": true,
            "only": [
                "fleetbase/fleetops-api"
            ]
        },
        {
            "type": "composer",
            "url": "https://registry.fleetbase.io",
            "canonical": false,
            "exclude": [
                "fleetbase/core-api",
                "fleetbase/fleetops-api",
                "fleetbase/storefront-api",
                "fleetbase/ledger-api",
                "fleetbase/customer-portal-api",
                "fleetbase/ai",
                "fleetbase/valhalla-api",
                "fleetbase/vroom-api"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "clear-logs": [
            "rm -rf storage/logs/*.log",
            "composer dump-autoload",
            "chmod -R 777 storage",
            "chmod -R 777 bootstrap/cache",
            "chmod -R 777 resources"
        ],
        "clean-logs": [
            "composer run-script clear-logs"
        ],
        "test:unit": "phpunit --colors=always",
        "test:coverage:clover": "mkdir -p coverage && XDEBUG_MODE=coverage phpunit --coverage-clover=coverage/clover.xml --colors=always",
        "coverage:summary": "php scripts/coverage-summary.php coverage/clover.xml",
        "coverage:check": "php scripts/coverage-summary.php coverage/clover.xml --fail-under=100",
        "coverage:baseline": [
            "@test:coverage:clover",
            "@coverage:summary"
        ],
        "test": [
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "secure-http": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
